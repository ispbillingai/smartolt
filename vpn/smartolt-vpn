#!/bin/bash
# The only root command the SmartOLT sites may run (sudoers: www-data, this file only).
#   smartolt-vpn add <username> <sha256 of password>   create or update a login, print its fixed IP
#   smartolt-vpn remove <username>                     delete a login and drop its tunnel
#   smartolt-vpn status <username>                     "connected <real address> <since>" or "offline"
# Fixed IPs use the installed /16 network. New installations use the private 10.253.0.0/16 range.

set -euo pipefail
umask 077
# Logins and fixed IPs live under /var/lib: PHP-FPM, and so this helper when a site calls it, runs
# with /etc read-only (systemd ProtectSystem).
DATA=/var/lib/smartolt-vpn
USERS="$DATA/users"
CCD="$DATA/ccd"
STATUS=/var/log/openvpn/smartolt-status.log
PARSER=/usr/local/libexec/smartolt-vpn-status.awk

# Public trust material only; the CA private key never leaves the PKI directory.
if [ "${1:-}" = trust ]; then
    [ "$#" -eq 1 ] || { echo 'usage: smartolt-vpn trust' >&2; exit 2; }
    [ -s "$DATA/server-name" ] && [ -s "$DATA/ca.crt" ] || { echo 'VPN certificate trust is not configured. Run vpn/setup_openvpn.sh with the canonical VPN hostname.' >&2; exit 5; }
    cat "$DATA/server-name" "$DATA/ca.crt"
    exit 0
fi

user="${2:-}"
[[ "$user" =~ ^[a-z0-9][a-z0-9-]{2,60}$ ]] || { echo "bad username" >&2; exit 2; }

# Read-only checks should not wait for a provisioning lock. A stopped daemon or stale status
# file is an error, never evidence that the router is connected.
if [ "${1:-}" = status ]; then
    systemctl is-active --quiet openvpn-server@smartolt || { echo "OpenVPN service is not running" >&2; exit 5; }
    [ -r "$STATUS" ] || { echo "VPN status file is unavailable" >&2; exit 5; }
    now=$(date +%s)
    modified=$(stat -c %Y "$STATUS")
    (( now - modified <= 90 && now - modified >= -30 )) || { echo "VPN status is stale; check the OpenVPN service" >&2; exit 5; }
    awk -v user="$user" -f "$PARSER" "$STATUS"
    exit $?
fi

exec 9>/run/smartolt-vpn.lock
flock -w 20 9 || { echo "busy" >&2; exit 3; }

case "${1:-}" in
    add)
        hash="${3:-}"
        [[ "$hash" =~ ^[0-9a-f]{64}$ ]] || { echo "bad password hash" >&2; exit 2; }
        if [ ! -f "$CCD/$user" ]; then
            # Old installations without a network file retain their existing addresses.
            prefix=17.0
            [ ! -f "$DATA/network" ] || read -r prefix < "$DATA/network"
            [[ "$prefix" =~ ^(10\.[0-9]{1,3}|172\.(1[6-9]|2[0-9]|3[01])|192\.168|17\.0)$ ]] || { echo "invalid VPN network" >&2; exit 4; }
            [[ "${prefix#*.}" -le 255 ]] || { echo "invalid VPN network" >&2; exit 4; }
            used=$(awk '/^ifconfig-push/ { print $2 }' "$CCD"/* 2>/dev/null || true)
            ip=""
            for a in $(seq 1 255); do
                for b in $(seq 1 254); do
                    if ! grep -Fqx "$prefix.$a.$b" <<< "$used"; then ip="$prefix.$a.$b"; break 2; fi
                done
            done
            [ -n "$ip" ] || { echo "no free tunnel IP" >&2; exit 4; }
            echo "ifconfig-push $ip 255.255.0.0" > "$CCD/$user"
        fi
        tmp=$(mktemp "$DATA/.users.XXXXXX")
        trap 'rm -f "${tmp:-}"' EXIT
        awk -v u="$user" '$1 != u' "$USERS" > "$tmp"
        echo "$user $hash" >> "$tmp"
        chmod 600 "$tmp"
        mv "$tmp" "$USERS"
        awk '/^ifconfig-push/ { print $2 }' "$CCD/$user"
        ;;
    remove)
        tmp=$(mktemp "$DATA/.users.XXXXXX")
        trap 'rm -f "${tmp:-}"' EXIT
        awk -v u="$user" '$1 != u' "$USERS" > "$tmp"
        chmod 600 "$tmp"
        mv "$tmp" "$USERS"
        rm -f "$CCD/$user"
        # drop a tunnel that is up right now, not only the next login
        if [ -S /run/smartolt-vpn-mgmt.sock ]; then
            printf 'kill %s\nquit\n' "$user" | timeout 3 nc -U /run/smartolt-vpn-mgmt.sock >/dev/null 2>&1 || { echo "Login removed, but the active tunnel could not be disconnected" >&2; exit 5; }
        fi
        echo removed
        ;;
    *)
        echo "usage: smartolt-vpn add|remove|status <username> [hash]" >&2
        exit 2
        ;;
esac
